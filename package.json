{
  "name": "pelada",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "robo": "tsx src/robo/principal.ts",
    "robo:ensaio": "tsx src/robo/principal.ts --ensaio",
    "robo:configurar": "tsx src/robo/principal.ts configurar",
    "robo:instalar": "tsx src/robo/instalar.ts",
    "robo:desinstalar": "tsx src/robo/instalar.ts desinstalar"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@vercel/functions": "^3.10.6",
    "baileys": "7.0.0-rc14",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "qrcode-terminal": "0.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "~1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode-terminal": "0.12.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.18.0"
}
