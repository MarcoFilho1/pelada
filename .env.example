# em produção (Neon): a URL com pool, host terminado em -pooler
DATABASE_URL=
# mínimo de 32 caracteres
SESSION_SECRET=
# primeiro admin, criado por `pnpm db:seed` se ainda não existir nenhum
ADMIN_USUARIO=
ADMIN_SENHA=
# (opcional) chave do sinal de vida do robô do celular, 24+ caracteres (docs/android.md)
ROBO_SINAL_CHAVE=
# (opcional) atualizações do robô do celular, 24+ caracteres cada (docs/android.md):
# a primeira vai no pacote do aparelho e só lê; a segunda fica só com quem publica
ROBO_ATUALIZACAO_CHAVE=
ROBO_PUBLICAR_CHAVE=
